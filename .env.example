# Frontend/backend public API origin
NEXT_PUBLIC_API_URL=http://localhost:8000
BASE_URL=http://localhost:8000

# Retrieval model. The default is stronger than the legacy CLIP ViT-B/32.
# Use EMBEDDING_MODEL=clip for the legacy baseline comparison.
EMBEDDING_MODEL=google/siglip-base-patch16-224

# Optional query rewriting provider
LLM_API_BASE=
LLM_API_KEY=
LLM_QUERY_MODEL=

# Voice model: tiny, base.en, small, or a hosted provider configured in code
WHISPER_MODEL=base.en
